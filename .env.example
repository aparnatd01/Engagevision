# EngageVision — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Flask ───────────────────────────────────────────────────────────────────
# Generate a strong random secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ─── MySQL Database ───────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_db_password_here
MYSQL_DB=engagevision

# ─── Flask Environment ────────────────────────────────────────────────────────
# Use "development" locally; "production" on a live server
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Used for: Teacher Forgot Password — sends a secure reset link to the teacher's email.
# Example uses Gmail SMTP with an App Password (not your Gmail account password).
# How to get a Gmail App Password: https://support.google.com/accounts/answer/185833
#
# For other providers:
#   Outlook/Hotmail: MAIL_SERVER=smtp-mail.outlook.com, MAIL_PORT=587
#   Yahoo:           MAIL_SERVER=smtp.mail.yahoo.com,   MAIL_PORT=465, MAIL_USE_TLS=false, MAIL_USE_SSL=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_DEFAULT_SENDER=ENGAGEVISION <your_email@gmail.com>

# ─── AI / Engagement Model ────────────────────────────────────────────────────
# Path to the trained MobileNetV2 engagement model (.h5 file)
# Generated by: python -m cv_engine.train
ENGAGEMENT_MODEL_PATH=cv_engine/models/engagement_model.h5

# DAiSEE dataset paths (needed for training only, not for inference)
# DAISEE_DATASET_DIR=DAiSEE/DataSet
# DAISEE_LABELS_DIR=DAiSEE/Labels
